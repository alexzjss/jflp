<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>jflp</groupId>
  <artifactId>jflp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>JFLP</name>
  <description>Spectrum-based fault localization for Java: per-test coverage agent and Jaguar2-compatible reports</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The jar must load on Java 5 JVMs: build with JDK 8, the newest javac that still emits Java 5 class files. -->
    <maven.compiler.source>1.5</maven.compiler.source>
    <maven.compiler.target>1.5</maven.compiler.target>
    <!-- Test fixtures use Java 8 constructs (lambdas, try-with-resources, string switch). -->
    <maven.compiler.testSource>1.8</maven.compiler.testSource>
    <maven.compiler.testTarget>1.8</maven.compiler.testTarget>
    <asm.version>9.11.1</asm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-commons</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <!-- Only its filters are used, to decide which lines hold source code exactly
           as JaCoCo does. 0.8.7 is the version the Jaguar2 fork uses, so the line
           sets, and with them the coverage matrix columns, are the same. -->
      <groupId>org.jacoco</groupId>
      <artifactId>org.jacoco.core</artifactId>
      <version>0.8.7</version>
      <exclusions>
        <exclusion>
          <groupId>org.ow2.asm</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>jflp</finalName>
    <resources>
      <resource>
        <directory>src/ui/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <showWarnings>false</showWarnings>
        </configuration>
        <executions>
          <execution>
            <!-- The web UI (java -jar jflp.jar ui) needs Java 8; the agent and the
                 report stay Java 5 and never load these classes. -->
            <id>compile-ui</id>
            <!-- After animal-sniffer (bound to compile) has checked the Java 5 classes. -->
            <phase>process-classes</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/ui/java</compileSourceRoot>
              </compileSourceRoots>
              <source>1.8</source>
              <target>1.8</target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Fails the build if main code calls any API newer than Java 5. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>animal-sniffer-maven-plugin</artifactId>
        <version>1.24</version>
        <configuration>
          <signature>
            <groupId>org.codehaus.mojo.signature</groupId>
            <artifactId>java15</artifactId>
            <version>1.0</version>
          </signature>
        </configuration>
        <executions>
          <execution>
            <phase>compile</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <!-- The agent sits on the boot class path, which wins over the
                     application's class path: an unrelocated ASM would replace
                     the ASM version of the project under test. -->
                <relocation>
                  <pattern>org.objectweb.asm</pattern>
                  <shadedPattern>jflp.internal.asm</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.jacoco</pattern>
                  <shadedPattern>jflp.internal.jacoco</shadedPattern>
                </relocation>
              </relocations>
              <minimizeJar>false</minimizeJar>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>META-INF/*.MF</exclude>
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>jflp.cli.Main</Main-Class>
                    <Premain-Class>jflp.agent.Agent</Premain-Class>
                    <!-- Java 5 fallback; Java 6+ appends the jar itself wherever it lives. -->
                    <Boot-Class-Path>jflp.jar</Boot-Class-Path>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
